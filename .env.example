# Ключ LLM API (OpenAI, OpenRouter или любой совместимый)
OPENAI_API_KEY=your-key-here

# Модель
LLM_MODEL=gpt-4o-mini

# Для OpenAI оставь пустым. Для других провайдеров:
# OpenRouter: https://openrouter.ai/api/v1   (модель например: openai/gpt-4o-mini)
# Ollama:     http://localhost:11434/v1      (ключ любой, например ollama; модель: qwen2.5:7b)
OPENAI_BASE_URL=
